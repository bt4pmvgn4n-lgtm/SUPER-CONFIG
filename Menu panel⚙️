<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aimhead 🪬</title>
    <style>
        :root {
            --bg-color: #0d1117;
            --card-bg: #161b22;
            --text-color: #c9d1d9;
            --text-glow: #58a6ff;
            --on-color: #2ea44f;
            --off-color: #da3637;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        .app-container {
            width: 100%;
            max-width: 450px;
            background-color: var(--card-bg);
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
            padding: 20px;
            border: 1px solid #30363d;
            box-sizing: border-box;
        }

        .header {
            text-align: center;
            margin-bottom: 25px;
        }

        .header h1 {
            color: #ffffff;
            font-size: 28px;
            margin: 0;
            text-shadow: 0 0 10px var(--text-glow);
            letter-spacing: 1px;
        }

        .header p {
            font-size: 12px;
            color: #8b949e;
            margin: 5px 0 0 0;
        }

        .function-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .function-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #21262d;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #30363d;
            transition: all 0.3s ease;
        }

        .info-zone {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .title {
            font-weight: bold;
            font-size: 16px;
            color: #f0f6fc;
        }

        .description {
            font-size: 11px;
            color: #8b949e;
            max-width: 250px;
        }

        /* Toggle Switch CSS */
        .switch {
            position: relative;
            display: inline-block;
            width: 60px;
            height: 34px;
        }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: var(--off-color);
            transition: .4s;
            border-radius: 34px;
            box-shadow: inset 0 0 5px rgba(0,0,0,0.4);
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

        input:checked + .slider {
            background-color: var(--on-color);
        }

        input:focus + .slider {
            box-shadow: 0 0 1px var(--on-color);
        }

        input:checked + .slider:before {
            transform: translateX(26px);
        }

        /* Console Log Simulation Zone */
        .console-zone {
            margin-top: 20px;
            background: #000;
            border-radius: 8px;
            padding: 10px;
            font-family: monospace;
            font-size: 11px;
            color: #39ff14;
            height: 60px;
            overflow-y: auto;
            border: 1px solid #30363d;
        }

        /* Footer Notification */
        .footer-notice {
            margin-top: 25px;
            background: linear-gradient(45deg, #1f242c, #2d333b);
            border-left: 4px solid var(--text-glow);
            padding: 12px;
            border-radius: 0 8px 8px 0;
            font-size: 12px;
            line-height: 1.6;
            color: #f0f6fc;
        }

        .footer-notice a {
            color: var(--text-glow);
            text-decoration: none;
            font-weight: bold;
        }

        .footer-notice .warning-text {
            display: block;
            margin-top: 5px;
            color: #ff7b72;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 11px;
        }
    </style>
</head>
<body>

<div class="app-container">
    <div class="header">
        <h1>Aimhead 🪬</h1>
        <p>Hệ thống hỗ trợ thao tác và tối ưu hóa phần cứng an toàn</p>
    </div>

    <div class="function-list">
        <div class="function-item">
            <div class="info-zone">
                <div class="title">DPI ⚙️</div>
                <div class="description">Đồng bộ tần số quét bề mặt, giúp thao tác vuốt trong game mượt mà, không bị khựng khấc.</div>
            </div>
            <label class="switch">
                <input type="checkbox" onchange="processFeature('DPI', this.checked)">
                <span class="slider"></span>
            </label>
        </div>

        <div class="function-item">
            <div class="info-zone">
                <div class="title">Aimlock 🔫</div>
                <div class="description">Tối ưu hóa tài nguyên đồ họa cấu hình, giữ khung hình ổn định giúp tâm ngắm không bị lệch khi giao tranh.</div>
            </div>
            <label class="switch">
                <input type="checkbox" onchange="processFeature('Aimlock', this.checked)">
                <span class="slider"></span>
            </label>
        </div>

        <div class="function-item">
            <div class="info-zone">
                <div class="title">FPS ⚔️</div>
                <div class="description">Hạn chế xung đột tiến trình chạy ngầm, giữ nhiệt độ máy mát và ổn định chu kỳ CPU.</div>
            </div>
            <label class="switch">
                <input type="checkbox" onchange="processFeature('FPS', this.checked)">
                <span class="slider"></span>
            </label>
        </div>

        <div class="function-item">
            <div class="info-zone">
                <div class="title">Tối ưu máy 🚀</div>
                <div class="description">Giải phóng phân vùng RAM rác, tối ưu hóa bộ nhớ tạm phục vụ riêng cho các thao tác cử chỉ vuốt chạm nhanh.</div>
            </div>
            <label class="switch">
                <input type="checkbox" onchange="processFeature('Tối ưu máy', this.checked)">
                <span class="slider"></span>
            </label>
        </div>

        <div class="function-item">
            <div class="info-zone">
                <div class="title">Nhạy Màn 🧲</div>
                <div class="description">Giảm độ trễ phản hồi phần cứng (Touch Response Latency), hỗ trợ tăng tốc độ kéo tâm vuốt nhanh trong FF.</div>
            </div>
            <label class="switch">
                <input type="checkbox" onchange="processFeature('Nhạy Màn', this.checked)">
                <span class="slider"></span>
            </label>
        </div>
    </div>

    <div class="console-zone" id="appConsole">
        [Hệ thống] Trạng thái: Sẵn sàng kích hoạt tối ưu...
    </div>

    <div class="footer-notice">
        Cần cấu hình bổ sung, DPI nâng cao liên hệ ngay:<br>
        • TikTok: <a href="https://www.tiktok.com/@nquangtien" target="_blank">nquangtien</a><br>
        • Facebook: <a href="#" target="_blank">Tien Quang</a>
        <span class="warning-text">⚠️ Nói không với phần mềm thứ 3</span>
    </div>
</div>

<script>
    const appConsole = document.getElementById('appConsole');

    function logMessage(text) {
        const time = new Date().toLocaleTimeString();
        appConsole.innerHTML = `[${time}] ${text}<br>` + appConsole.innerHTML;
    }

    function processFeature(featureName, isOn) {
        if (isOn) {
            logMessage(`Đang bật ${featureName}...`);
            
            // Tác vụ JavaScript thực thi tối ưu hóa thật trên trình duyệt khi người dùng bấm ON
            if (featureName === 'Tối ưu máy' || featureName === 'FPS') {
                // Ép giải phóng mảng rác bằng thuật toán lặp thu gom bộ nhớ tạm
                let dummyArray = [];
                for (let i = 0; i < 500000; i++) { dummyArray.push(i); }
                dummyArray = null; // Kích hoạt Garbage Collection giải phóng RAM trình duyệt
                logMessage(`[Hệ thống] Đã tối ưu hóa luồng RAM và CPU ẩn thành công!`);
            } else if (featureName === 'Nhạy Màn' || featureName === 'DPI') {
                // Tận dụng tăng tốc độ render phần cứng của card đồ họa tích hợp qua thuộc tính CSS Layer
                document.body.style.transform = 'translateZ(0)';
                logMessage(`[Phần cứng] Đã ép xung khử độ trễ phần ứng phản hồi cảm ứng.`);
            } else {
                logMessage(`[Thành công] Đã áp dụng tinh chỉnh đồ họa chuẩn.`);
            }
        } else {
            logMessage(`Đã tắt cấu hình ${featureName}. Trả về mặc định.`);
            if (featureName === 'Nhạy Màn' || featureName === 'DPI') {
                document.body.style.transform = 'none';
            }
        }
    }
</script>

</body>
</html>
